# ==========================================
# Plaid Configuration
# ==========================================
PLAID_CLIENT_ID=your_plaid_client_id
# Environment: 'sandbox' or 'production' (or 'development' if legacy)
PLAID_ENV=sandbox
# You can provide both secrets, and the active secret is automatically selected by PLAID_ENV:
PLAID_SANDBOX_SECRET=your_plaid_sandbox_secret
PLAID_PRODUCTION_SECRET=your_plaid_production_secret
# Fallback / single secret:
# PLAID_SECRET=your_plaid_secret
# Optional: OAuth redirect URI if configured in your Plaid Dashboard
# PLAID_REDIRECT_URI=http://localhost:8085/oauth-callback

# ==========================================
# Actual Budget Configuration
# ==========================================
ACTUAL_SERVER_URL=http://localhost:5006
ACTUAL_PASSWORD=your_actual_server_password
ACTUAL_SYNC_ID=your_actual_budget_sync_id
# Optional: Encryption password if your budget file uses E2E encryption
# ACTUAL_ENCRYPTION_PASSWORD=your_budget_file_encryption_password
# Optional: Cache directory for Actual API client local storage
# ACTUAL_DATA_DIR=/var/lib/gone-to-plaid/actual-data

# ==========================================
# Daemon Server Settings
# ==========================================
PORT=8085
DATA_DIR=./data
# Periodic sync interval in minutes (0 to disable internal daemon timer, e.g. when using systemd timers)
SYNC_INTERVAL_MINUTES=240
